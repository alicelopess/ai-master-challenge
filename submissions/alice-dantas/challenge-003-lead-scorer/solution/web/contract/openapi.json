            "const": "group",
            "title": "Role"
          },
          "params": {
            "$ref": "#/components/schemas/AgeParams"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "role",
          "params"
        ],
        "title": "AgeAboveCycleLimit",
        "description": "Engaging com idade acima do maior ciclo fechado: grupo revisar."
      },
      "AgeParams": {
        "properties": {
          "age_days": {
            "type": "integer",
            "title": "Age Days",
