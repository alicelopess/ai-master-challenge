          "high_pct": {
            "type": "integer",
            "title": "High Pct",
            "description": "Se todas as abertas fossem ganhas, em %."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "won",
          "closed",
          "open",
          "pct",
          "low_pct",
          "high_pct"
        ],
        "title": "BaseRate"
      },
      "ClosedBaseRate": {
        "properties": {
