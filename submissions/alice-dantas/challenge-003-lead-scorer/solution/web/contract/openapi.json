            "$ref": "#/components/schemas/FieldParams"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "params"
        ],
        "title": "FixFieldAction"
      },
      "Group": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
