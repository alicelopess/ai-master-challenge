              {
                "type": "null"
              }
            ],
            "title": "Missing Field"
          },
          "tie_size": {
            "type": "integer",
            "title": "Tie Size",
            "description": "Quantas oportunidades do mesmo grupo e produto (mesmo preço) há na carteira."
