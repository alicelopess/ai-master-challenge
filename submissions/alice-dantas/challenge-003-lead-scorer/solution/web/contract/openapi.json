                "type": "null"
              }
            ],
            "title": "Empty",
            "description": "Nulo quando o grupo tem oportunidades."
          },
          "next_action": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/SimpleAction"
                  },
                  {
                    "$ref": "#/components/schemas/FixFieldAction"
                  }
                ],
                "discriminator": {
                  "propertyName": "code",
                  "mapping": {
                    "advance_prospecting": "#/components/schemas/SimpleAction",
                    "confirm_still_active": "#/components/schemas/SimpleAction",
                    "fix_missing_field": "#/components/schemas/FixFieldAction",
                    "fix_missing_fields": "#/components/schemas/SimpleAction",
                    "work_highest_list_price_first": "#/components/schemas/SimpleAction"
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Action",
            "description": "Nulo quando o grupo está vazio."
