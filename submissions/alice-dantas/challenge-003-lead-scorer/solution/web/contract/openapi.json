                {
                  "$ref": "#/components/schemas/ProspectingStage"
                },
                {
                  "$ref": "#/components/schemas/MissingFieldReason"
                },
                {
                  "$ref": "#/components/schemas/ListPrice"
                },
                {
                  "$ref": "#/components/schemas/NoProduct"
                },
                {
                  "$ref": "#/components/schemas/NoListPrice"
                },
                {
                  "$ref": "#/components/schemas/WonCycleReference"
                },
                {
                  "$ref": "#/components/schemas/NoCycleReference"
                },
                {
                  "$ref": "#/components/schemas/ClosedBaseRate"
                }
              ],
              "discriminator": {
                "propertyName": "code",
                "mapping": {
                  "age_above_cycle_limit": "#/components/schemas/AgeAboveCycleLimit",
                  "age_within_cycle_limit": "#/components/schemas/AgeWithinCycleLimit",
                  "closed_base_rate": "#/components/schemas/ClosedBaseRate",
                  "list_price": "#/components/schemas/ListPrice",
                  "missing_field": "#/components/schemas/MissingFieldReason",
                  "no_cycle_reference": "#/components/schemas/NoCycleReference",
                  "no_list_price": "#/components/schemas/NoListPrice",
                  "no_product": "#/components/schemas/NoProduct",
                  "prospecting_stage": "#/components/schemas/ProspectingStage",
                  "won_cycle_reference": "#/components/schemas/WonCycleReference"
                }
              }
            },
            "type": "array",
            "title": "Reasons",
            "description": "Um motivo de grupo, um de ordem e os de contexto, nesta ordem."
          },
          "next_action": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SimpleAction"
              },
              {
                "$ref": "#/components/schemas/FixFieldAction"
              }
            ],
            "title": "Next Action",
            "discriminator": {
              "propertyName": "code",
              "mapping": {
                "advance_prospecting": "#/components/schemas/SimpleAction",
                "confirm_still_active": "#/components/schemas/SimpleAction",
                "fix_missing_field": "#/components/schemas/FixFieldAction",
                "fix_missing_fields": "#/components/schemas/SimpleAction",
                "work_highest_list_price_first": "#/components/schemas/SimpleAction"
              }
            }
