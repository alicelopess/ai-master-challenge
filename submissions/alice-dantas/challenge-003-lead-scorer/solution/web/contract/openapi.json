                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Days",
            "description": "Dias corridos de engage_date até o as_of."
          },
          "group": {
            "type": "string",
            "enum": [
              "focar",
              "revisar",
              "qualificar",
              "nao_pontuavel"
