      "ErrorBody": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Mensagem do núcleo, a mesma da CLI."
          },
          "code": {
            "type": "string",
            "enum": [
              "data_file_missing",
              "data_file_empty",
              "data_file_invalid",
              "data_columns_missing",
              "data_unknown_label",
              "data_bad_date",
              "data_duplicate_key",
              "data_bad_price",
              "invalid_as_of_format",
              "as_of_before_last_close",
              "seller_not_found",
              "opportunity_not_found"
